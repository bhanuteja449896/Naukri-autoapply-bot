# Naukri Auto-Apply Bot Configuration
# Copy this file to .env and fill in your details
# NEVER commit .env, token.json, or credentials.json to git

# ─── Naukri Credentials ───────────────────────────────────────────────────────
NAUKRI_EMAIL=your_email@example.com
NAUKRI_PASSWORD=your_password

# ─── Personal Details ─────────────────────────────────────────────────────────
FIRSTNAME=YourFirstName
LASTNAME=YourLastName

# ─── Job Search ───────────────────────────────────────────────────────────────
# Comma-separated keywords
KEYWORDS=python developer, data analyst, software engineer

# Location (leave blank for all India, or use city name)
LOCATION=bangalore

# Allowed locations filter (comma-separated, e.g.: Hyderabad, Bengaluru, Chennai)
# When set, the bot performs a unified nationwide search and applies only to jobs in these cities.
# Leave blank to apply to all cities nationwide.
ALLOWED_LOCATIONS=

# Experience filter (years — leave blank to disable)
EXPERIENCE_MIN=0
EXPERIENCE_MAX=3

# Minimum annual salary in rupees (leave blank to disable)
# Example: 300000 = ₹3 LPA
SALARY_MIN=

# ─── Freshness Filter ─────────────────────────────────────────────────────────
# jobAge: 1 = last 24 hours, 3 = last 3 days, 7 = last 7 days
JOB_AGE_DAYS=1

# ─── Limits ───────────────────────────────────────────────────────────────────
# Pages to scrape per keyword (each page ~20 jobs)
PAGES_PER_KEYWORD=2

# Max applications per run (Naukri daily limit ≈ 100)
MAX_APPLICATIONS=50

# ─── Google Sheets ────────────────────────────────────────────────────────────
# The ID from your sheet URL:
# https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Sheet tab name (default: Applications)
SHEET_NAME=Applications

# ─── Browser ──────────────────────────────────────────────────────────────────
# Set to "true" on servers (Cloud Run, Railway, etc.)
# Set to "false" on your local machine to see the browser
HEADLESS=false

# ─── Sheet Tab Names (must match tabs in your Google Sheet) ───────────────────
# Tab 1: Jobs that need manual apply on company website
SHEET_EXTERNAL=Apply on Website
# Tab 2: Jobs directly applied on Naukri
SHEET_DIRECT=Direct Applied

# ─── Cloud Storage (Optional for Cloud Run session persistence) ───────────────
# When running on Cloud Run, set this to sync your session across hourly runs
# GCS_BUCKET=your-project-id-naukri-session
